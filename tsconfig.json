{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@ui-common": ["./components/ui-common"],
      "@ui-common/*": ["./components/ui-common/*"],
      "@ui-component": ["./components/ui-component"],
      "@ui-component/*": ["./components/ui-component/*"],
      "@ui-widget": ["./components/ui-widget"],
      "@ui-widget/*": ["./components/ui-widget/*"],
      "@ui-element": ["./components/ui-element"],
      "@ui-element/*": ["./components/ui-element/*"],
      "@ui-svg": ["./components/ui-svg"],
      "@ui-svg/*": ["./components/ui-svg/*"],
      "@ui-layout/*": ["./components/ui-layout/*"],
      "@ui-animations/*": ["./components/ui-animations/*"],
      "@lib": ["./lib"],
      "@lib/*": ["./lib/*"],
      "@hooks": ["./hooks"],
      "@hooks/*": ["./hooks/*"],
      "@public/*": ["./public/*"],
      "@types": ["./types"],
      "@types/*": ["./types/*"],
      "@utils": ["./utils"],
      "@utils/*": ["./utils/*"],
      "@data": ["./data"],
      "@data/*": ["./data/*"],
      "@services": ["./services"],
      "@services/*": ["./services/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
